{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .bob/hooks/bob2-context.py SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .bob/hooks/bob2-context.py UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
