# Optional overrides. Copy to .bob/bob-v2.env; do not replace the existing .env.
# BOB2_BIN=/absolute/path/to/bob
BOB2_CHAT_AUTO_APPROVE=1
BOB2_AUTH_PROBE=1
BOB2_MAX_TURNS=50
BOB2_OUTPUT_FORMAT=pretty
BOB2_LOG_LEVEL=warn
# BOB_TEAM_ID=your-team-id
# BOB2_INSTANCE_ID=your-real-bob-instance-id
# BOB2_INTERACTIVE_MODE=project-mode-slug
# BOB2_ASK_MODE=project-mode-slug
# BOB2_CODE_MODE=project-mode-slug
# BOB2_ADVANCED_MODE=project-mode-slug
# BOB2_RESUME_MODE=project-mode-slug
# Set only when a custom/private backend explicitly needs the old endpoint variables:
BOB2_PRESERVE_LEGACY_ENDPOINT_OVERRIDES=0
